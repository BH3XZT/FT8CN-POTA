<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/help_dialog_style"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/logServerTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/log_web_title"
        android:textColor="@color/help_dialog_text_color"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/logServerHintTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/log_web_hint"
        android:textColor="@color/help_dialog_text_color"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/logServerQrImageView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#FFFFFFFF"
        android:contentDescription="@string/log_web_title"
        android:padding="8dp" />

    <TextView
        android:id="@+id/logServerUrlTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/help_dialog_text_color"
        android:textIsSelectable="true"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyUrlButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/imagebutton_style"
            android:text="@string/copy_url"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openUrlButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/imagebutton_style"
            android:text="@string/open_url"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/closeLogServerButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/imagebutton_style"
            android:text="@string/close"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
