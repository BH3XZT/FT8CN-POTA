<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/ft8cn_brand_bar"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="2dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/barToCallsignTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/bar_text_view_color"
            android:textSize="11sp"
            tools:ignore="TextContrastCheck" />

        <TextView
            android:id="@+id/barBaseFrequencyTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/bar_text_view_color"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/barSequentialTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/bar_text_view_color"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/barSetTransmitImageButton"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/imagebutton_style"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_baseline_cancel_schedule_send_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/barShowCallingListImageButton"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:background="@drawable/imagebutton_style"
            android:contentDescription="@string/calling_list_button"
            android:src="@drawable/ic_baseline_list_alt_24" />

        <ImageButton
            android:id="@+id/barPauseImageButton"
            android:layout_width="32dp"
            android:layout_height="30dp"
            android:background="@drawable/imagebutton_style"
            android:contentDescription="@string/launch"
            android:src="@drawable/ic_baseline_pause_circle_outline_24"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/barFunctionOrderSpinner"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/editor_style"
            android:dropDownWidth="match_parent"
            android:popupBackground="@drawable/spinner_style"
            android:spinnerMode="dropdown"
            android:visibility="gone"
            tools:ignore="SpeakableTextPresentCheck" />

        <EditText
            android:id="@+id/barFreeTextEdit"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/editor_style"
            android:digits=" 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            android:ems="8"
            android:hint="@string/transmit_freeText"
            android:inputType="text"
            android:visibility="gone"
            tools:ignore="TextContrastCheck" />

        <ImageButton
            android:id="@+id/barResetToCQImageButton"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:background="@drawable/imagebutton_style"
            android:contentDescription="@string/send"
            android:src="@drawable/cq" />
    </LinearLayout>
</LinearLayout>
