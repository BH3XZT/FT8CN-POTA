<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.（夜间：固定深蓝色） -->
    <style name="Theme.Ft8CN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/night_accent</item>
        <item name="colorPrimaryVariant">@color/night_bar_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/ft8cn_brand_bar_variant</item>
        <!-- 界面品牌表面颜色：夜间固定深蓝色 -->
        <item name="ft8cn_brand_bar">@color/night_bar_primary</item>
        <item name="ft8cn_brand_bar_variant">@color/night_bar_variant</item>
    </style>
</resources>
